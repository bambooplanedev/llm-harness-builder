{
  "name": "llm-harness-builder",
  "version": "0.5.0",
  "description": "See what your agent harness really sends to the model — local or cloud — and why it fails",
  "license": "MIT",
  "author": "bambooplanedev <vk@bambooplane.dev>",
  "repository": { "type": "git", "url": "git+https://github.com/bambooplanedev/llm-harness-builder.git" },
  "homepage": "https://github.com/bambooplanedev/llm-harness-builder#readme",
  "bugs": { "url": "https://github.com/bambooplanedev/llm-harness-builder/issues" },
  "keywords": ["llm", "agent", "harness", "local-llm", "llama.cpp", "ollama", "tool-calling", "tracing", "benchmark"],
  "type": "module",
  "bin": {
    "llm-harness-builder": "dist/cli.js"
  },
  "files": [
    "dist",
    "web/dist",
    "harnesses",
    "!harnesses/*.evolve*.jsonl",
    "!harnesses/*.v[0-9]*.json",
    "examples",
    "examples-pool",
    "examples-polyglot",
    "examples-sift",
    "examples-triage",
    "example-runs"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && node web/typecheck.cjs --noEmit -p web/tsconfig.json",
    "dev:server": "tsx src/cli.ts serve --no-open",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "cli": "tsx src/cli.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@5.9",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
