{
  "name": "llm-harness-builder",
  "version": "0.3.0",
  "description": "See what your agent harness really sends to a local LLM, and why it fails",
  "license": "MIT",
  "type": "module",
  "bin": {
    "llm-harness-builder": "dist/cli.js"
  },
  "files": [
    "dist",
    "web/dist",
    "harnesses",
    "examples",
    "examples-pool",
    "examples-sift",
    "examples-triage"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && node web/typecheck.cjs --noEmit -p web/tsconfig.json",
    "dev:server": "tsx src/cli.ts serve --no-open",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "cli": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "undici": "^7.29.1",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@5.9",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
